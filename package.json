{
  "name": "panel-de-pon-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Faithful web re-implementation of Panel de Pon (SNES) with online 2-player Vs.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch src/server/main.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node src/server/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "rip:ost": "node tools/rip-snes-audio.ts"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
